rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isFacturation() {
      return isAuthenticated() && getUserRole() == 'facturation';
    }

    function isPicker() {
      return isAuthenticated() && (getUserRole() == 'picker' || getUserRole() == 'alistador');
    }

    function isDelivery() {
      return isAuthenticated() && getUserRole() == 'delivery';
    }

    function isValidUserRole(rol) {
      return rol in ['admin', 'facturation', 'picker', 'alistador', 'delivery'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidPickerOrderUpdate() {
      return resource.data.estado in ['PENDIENTE_ALISTAMIENTO', 'EN_ALISTAMIENTO', 'ALISTADO']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items',
          'pickingProgress',
          'estado',
          'generalObservationChecked',
          'generalObservationAudit',
          'reliquidation',
          'hasPostPickingAdditions',
          'updatedAt'
        ])
        && request.resource.data.estado in ['PENDIENTE_ALISTAMIENTO', 'EN_ALISTAMIENTO', 'ALISTADO']
        && request.resource.data.items is list
        && request.resource.data.updatedAt is string
        && (!('pickingProgress' in request.resource.data) || (
          request.resource.data.pickingProgress is number
          && request.resource.data.pickingProgress >= 0
          && request.resource.data.pickingProgress <= 100
        ))
        && (!('generalObservationChecked' in request.resource.data) || (
          request.resource.data.generalObservationChecked is bool
        ))
        && (!('hasPostPickingAdditions' in request.resource.data) || (
          request.resource.data.hasPostPickingAdditions is bool
        ))
        && (!('generalObservationAudit' in request.resource.data) || (
          request.resource.data.generalObservationAudit is map
          && request.resource.data.generalObservationAudit.keys().hasOnly(['uid', 'userName', 'action', 'timestamp'])
          && request.resource.data.generalObservationAudit.uid == request.auth.uid
        ));
    }

    function isValidDeliveryOrderUpdate() {
      return resource.data.estado in ['LISTO_PARA_REPARTO', 'EN_RUTA', 'ENTREGADO']
        && request.resource.data.estado in ['LISTO_PARA_REPARTO', 'EN_RUTA', 'ENTREGADO']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'facturaNumber',
          'id_cliente',
          'id_vendedor',
          'createdAt'
        ])
        && request.resource.data.updatedAt is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidUserRole(request.resource.data.rol);
      allow delete: if isAdmin();
    }

    match /routes/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isFacturation();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (isAdmin() || isFacturation() || isPicker() || isDelivery());
      allow create: if isAdmin() || isFacturation();
      allow update: if isAdmin()
        || isFacturation()
        || (isPicker() && isValidPickerOrderUpdate())
        || (isDelivery() && isValidDeliveryOrderUpdate());
      allow delete: if isAdmin() || isFacturation();
    }

    match /settings/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
