{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@rutea/shared": ["./shared/index.ts"],
      "@rutea/shared/*": ["./shared/*"]
    }
  },
  "include": ["shared/**/*.ts", "shared/**/*.tsx"],
  "exclude": ["node_modules", "rutea-facturation", "rutea-fulfillment"]
}
